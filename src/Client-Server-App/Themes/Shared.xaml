<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Read-only console-style output pane shared by all windows -->
    <Style x:Key="LogOutput" TargetType="{x:Type TextBox}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- Connection dialog form rhythm -->
    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style x:Key="FormField" TargetType="{x:Type TextBox}">
        <Setter Property="Width" Value="200" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="ActionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="100" />
    </Style>

</ResourceDictionary>
