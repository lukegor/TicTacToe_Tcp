<Window x:Class="TicTacToe.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Connection" Height="540" Width="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="Themes/Shared.xaml" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Connect to a game"
                   Style="{StaticResource PageTitle}"
                   Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Join card -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="Join a game" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="IP Address:" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="AddressTextBox"
                             Style="{StaticResource FormField}"
                             Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Port:" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PortTextBox"
                             Style="{StaticResource FormField}"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Your name (optional):" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameTextBox"
                             Style="{StaticResource FormField}"
                             MaxLength="30"
                             Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button x:Name="ConnectButton"
                            Content="Connect"
                            Style="{StaticResource PrimaryButton}"
                            Height="34" HorizontalAlignment="Stretch"
                            Command="{Binding ConnectCommand}" />
                </StackPanel>
            </Border>

            <!-- Host card -->
            <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="Host a new game" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Port:" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HostPortTextBox"
                             Style="{StaticResource FormField}"
                             Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" />
                    <Button x:Name="HostButton"
                            Content="Create Host"
                            Style="{StaticResource PrimaryButton}"
                            Height="34" HorizontalAlignment="Stretch"
                            Command="{Binding HostCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Message log -->
        <TextBox x:Name="OutputTextBox"
                 Grid.Row="2"
                 Style="{StaticResource LogOutput}"
                 Margin="0,16,0,0"
                 IsReadOnlyCaretVisible="False"
                 VerticalContentAlignment="Top"
                 Text="{Binding LogText, Mode=OneWay}" />
    </Grid>
</Window>
